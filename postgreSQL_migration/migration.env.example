# Copy this file to postgreSQL_migration/.env and fill it in. .env is ignored by git; never commit it.

# ---- Source: Aiven MySQL (Aiven console > your MySQL service > Overview > Connection information)
MYSQL_HOST=mysql-xxxxxxxx-yourproject.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
# Download "CA certificate" from the same Aiven page and point to it, so the server certificate is verified.
MYSQL_SSL_CA=./ca.pem

# ---- Target: Supabase PostgreSQL
# Supabase dashboard > Connect > "Session pooler" URI (port 5432). Put your database password in place of [YOUR-PASSWORD].
# If the password contains characters such as @ : / ? # %, URL-encode them (e.g. @ -> %40).
PG_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
